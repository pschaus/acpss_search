\begin{tikzpicture}[
    mynode/.style={circle, fill=red!70, inner sep=0pt, minimum size=6pt},
    myarrow/.style={-{Stealth[length=2.5mm]}, line width=1.2pt}
]

% Coordinates of the cities
    \coordinate (0) at (-1.7,0);
    \coordinate (1) at (-0.8,1.5);
    \coordinate (2) at (1.5,1.8);
    \coordinate (3) at (1.8,-0.3);
    \coordinate (4) at (0.8,-0.5);
    \coordinate (5) at (0.8,-1.5);
    \coordinate (6) at (-1.5,-1.5);

% Draw nodes and labels
    \foreach \i in {0,...,6} {
        \node[mynode] (\i) at (\i) {};
        \node[above, left] at (\i) {\i};
    }

% Draw the circuit for Iteration 3
    \draw[myarrow] (0) -- (1);
    \draw[myarrow] (1) -- (2);
    \draw[myarrow] (2) -- (3);
    \draw[myarrow] (3) -- (4);
    \draw[myarrow] (4) -- (5);
    \draw[myarrow] (5) -- (6);
    \draw[myarrow] (6) -- (0);
\end{tikzpicture}